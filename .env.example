# Catalog metadata. Required.
# Create a free account at https://www.themoviedb.org/settings/api and copy the
# "API Read Access Token" (the long v4 JWT, not the short v3 key).
#
# Server-only — the browser never sees it. Requests go through /api/tmdb.
TMDB_TOKEN=

# Region used for release dates and streaming availability. ISO 3166-1 alpha-2.
NEXT_PUBLIC_REGION=IN

# Public origin of the deployed site, no trailing slash. Makes og:image, og:url
# and canonical absolute — crawlers need absolute URLs. Leave blank in
# development and they stay root-relative.
SITE_URL=

# ---------------------------------------------------------------------------
# Playback source. Optional — leave blank and the app plays trailers only.
#
# Supply a URL template for whatever backend you want to play from. The app
# substitutes these placeholders and loads the result in the player:
#
#   {type}     "movie" or "tv"
#   {tmdb}     TMDB numeric id
#   {imdb}     IMDb id, e.g. tt0111161 (empty when TMDB has none on file)
#   {season}   season number  (TV only, empty for movies)
#   {episode}  episode number (TV only, empty for movies)
#
# Use MOVIE and SERIES templates when your backend needs different shapes.
# If only NEXT_PUBLIC_SOURCE_URL is set, it is used for both.
NEXT_PUBLIC_SOURCE_URL=
NEXT_PUBLIC_SOURCE_URL_MOVIE=
NEXT_PUBLIC_SOURCE_URL_SERIES=

# Name shown on the source switcher in the player.
NEXT_PUBLIC_SOURCE_LABEL=Configured source

# ---------------------------------------------------------------------------
# Accounts. Required — every route except /sign-in and /sign-up is gated.
# Keys come from https://dashboard.clerk.com → your app → API keys.
# Who may sign up is dashboard configuration, not code: Configure →
# Restrictions → sign-up mode "Restricted", then add the allowed addresses.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ---------------------------------------------------------------------------
# Library storage. Required — the watchlist and history live in a Vercel Blob
# store, one JSON document per user. Create the store in the Vercel dashboard
# (Storage → Blob) and pull the token with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
